# SleepNest frontend environment variables
# Copy to `.env` (local) and set the backend API URL. Only VITE_* values reach the browser,
# so NEVER put database strings, JWT secrets or API keys in this file.

# Local backend
VITE_API_URL=http://localhost:5000/api

# Production example (after deploying the backend to Render):
# VITE_API_URL=https://sleepnest-api.onrender.com/api
